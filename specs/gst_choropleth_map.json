{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Map 1: mean growing season temperature (Oct-Apr, 1997-2017) of every Australian wine region (GI), as a choropleth in 5 bands. Same two panels and projections as Map 2 (the SE panel has 80 px more at the top so South Burnett fits). Values and the label list come from scripts/build_gst.py; tooltips from data/gi_region_info.csv (scripts/build_gi_info.py).",
  "spacing": 20,
  "hconcat": [
    {
      "vconcat": [
        {
          "name": "WA",
          "title": {
            "text": "Western Australia",
            "fontSize": 12,
            "fontWeight": 500,
            "color": "var(--ink-3)"
          },
          "width": 220,
          "height": 260,
          "projection": {
            "type": "conicEqualArea",
            "parallels": [-30, -36],
            "rotate": [-117, 0],
            "scale": 3302.489,
            "translate": [128.849, -3150.264],
            "clipExtent": [[0, 0], [220, 260]]
          },
          "layer": [
            {
              "data": {
                "url": "data/world-110m.json",
                "format": {"type": "topojson", "feature": "countries"}
              },
              "transform": [{"filter": "datum.id == 36"}],
              "mark": {"type": "geoshape", "style": "land"}
            },
            {
              "data": {
                "url": "data/gi_regions.topojson",
                "format": {"type": "topojson", "feature": "wine_gi_regions"}
              },
              "transform": [
                {
                  "lookup": "properties.GI_NAME",
                  "from": {
                    "data": {
                      "url": "data/gi_region_info.csv",
                      "format": {"type": "csv", "parse": {"gst_c": "number"}}
                    },
                    "key": "gi_name",
                    "fields": ["label", "gst_c", "gst_note"]
                  }
                }
              ],
              "mark": {"type": "geoshape", "stroke": "var(--paper)", "strokeWidth": 0.6},
              "encoding": {
                "color": {
                  "field": "gst_c",
                  "type": "quantitative",
                  "title": "Growing season temperature (°C)",
                  "scale": {"type": "threshold", "domain": [15, 17, 19, 21], "range": "gst"},
                  "legend": {
                    "orient": "none",
                    "legendX": 0,
                    "legendY": 300,
                    "type": "symbol",
                    "symbolType": "square",
                    "symbolSize": 180,
                    "symbolStrokeWidth": 0,
                    "title": "Growing season temp. (°C)",
                    "labelFontSize": 11.5
                  }
                },
                "tooltip": [
                  {"field": "label", "title": "Wine region"},
                  {"field": "properties.STATE", "title": "State"},
                  {"field": "gst_c", "title": "Growing season temp. (°C)", "format": ".1f"},
                  {"field": "gst_note", "title": "Note"}
                ]
              }
            },
            {
              "data": {
                "url": "data/gst_map_labels.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "llon": "number",
                    "llat": "number",
                    "dot": "number"
                  }
                }
              },
              "transform": [{"filter": "datum.view === 'WA'"}],
              "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"}
              },
              "layer": [
                {
                  "transform": [{"filter": "datum.dot === 1"}],
                  "mark": {"type": "circle", "size": 14, "color": "var(--ink-2)", "opacity": 1}
                },
                {
                  "transform": [{"filter": "datum.align === 'left'"}],
                  "mark": {
                    "type": "text",
                    "align": "left",
                    "baseline": "middle",
                    "style": ["bubble-label", "label-halo"]
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                },
                {
                  "transform": [{"filter": "datum.align === 'left'"}],
                  "mark": {
                    "type": "text",
                    "align": "left",
                    "baseline": "middle",
                    "style": "bubble-label"
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                },
                {
                  "transform": [{"filter": "datum.align === 'right'"}],
                  "mark": {
                    "type": "text",
                    "align": "right",
                    "baseline": "middle",
                    "style": ["bubble-label", "label-halo"]
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                },
                {
                  "transform": [{"filter": "datum.align === 'right'"}],
                  "mark": {
                    "type": "text",
                    "align": "right",
                    "baseline": "middle",
                    "style": "bubble-label"
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                },
                {
                  "transform": [{"filter": "datum.align === 'center'"}],
                  "mark": {
                    "type": "text",
                    "align": "center",
                    "baseline": "middle",
                    "style": ["bubble-label", "label-halo"]
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                },
                {
                  "transform": [{"filter": "datum.align === 'center'"}],
                  "mark": {
                    "type": "text",
                    "align": "center",
                    "baseline": "middle",
                    "style": "bubble-label"
                  },
                  "encoding": {
                    "longitude": {"field": "llon", "type": "quantitative"},
                    "latitude": {"field": "llat", "type": "quantitative"},
                    "text": {"field": "label"}
                  }
                }
              ]
            }
          ]
        },
        {
          "width": 220,
          "height": 150,
          "mark": {"type": "point", "opacity": 0},
          "data": {"values": [{}]}
        }
      ],
      "spacing": 24
    },
    {
      "name": "SE",
      "title": {
        "text": "South-eastern Australia",
        "fontSize": 12,
        "fontWeight": 500,
        "color": "var(--ink-3)"
      },
      "width": 580,
      "height": 622,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [-30, -40],
        "rotate": [-144, 0],
        "scale": 1751.476,
        "translate": [312.961, -1435.18],
        "clipExtent": [[0, 0], [580, 622]]
      },
      "layer": [
        {
          "data": {
            "url": "data/world-110m.json",
            "format": {"type": "topojson", "feature": "countries"}
          },
          "transform": [{"filter": "datum.id == 36"}],
          "mark": {"type": "geoshape", "style": "land"}
        },
        {
          "data": {
            "url": "data/gi_regions.topojson",
            "format": {"type": "topojson", "feature": "wine_gi_regions"}
          },
          "transform": [
            {
              "lookup": "properties.GI_NAME",
              "from": {
                "data": {
                  "url": "data/gi_region_info.csv",
                  "format": {"type": "csv", "parse": {"gst_c": "number"}}
                },
                "key": "gi_name",
                "fields": ["label", "gst_c", "gst_note"]
              }
            }
          ],
          "mark": {"type": "geoshape", "stroke": "var(--paper)", "strokeWidth": 0.6},
          "encoding": {
            "color": {
              "field": "gst_c",
              "type": "quantitative",
              "title": "Growing season temperature (°C)",
              "scale": {"type": "threshold", "domain": [15, 17, 19, 21], "range": "gst"},
              "legend": {
                "orient": "none",
                "legendX": 0,
                "legendY": 300,
                "type": "symbol",
                "symbolType": "square",
                "symbolSize": 180,
                "symbolStrokeWidth": 0,
                "title": "Growing season temp. (°C)",
                "labelFontSize": 11.5
              }
            },
            "tooltip": [
              {"field": "label", "title": "Wine region"},
              {"field": "properties.STATE", "title": "State"},
              {"field": "gst_c", "title": "Growing season temp. (°C)", "format": ".1f"},
              {"field": "gst_note", "title": "Note"}
            ]
          }
        },
        {
          "data": {
            "url": "data/gst_map_labels.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lon": "number",
                "lat": "number",
                "llon": "number",
                "llat": "number",
                "dot": "number"
              }
            }
          },
          "transform": [{"filter": "datum.view === 'SE'"}],
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          },
          "layer": [
            {
              "transform": [{"filter": "datum.dot === 1"}],
              "mark": {"type": "circle", "size": 14, "color": "var(--ink-2)", "opacity": 1}
            },
            {
              "transform": [{"filter": "datum.align === 'left'"}],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "style": ["bubble-label", "label-halo"]
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            },
            {
              "transform": [{"filter": "datum.align === 'left'"}],
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "style": "bubble-label"
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            },
            {
              "transform": [{"filter": "datum.align === 'right'"}],
              "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "style": ["bubble-label", "label-halo"]
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            },
            {
              "transform": [{"filter": "datum.align === 'right'"}],
              "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "style": "bubble-label"
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            },
            {
              "transform": [{"filter": "datum.align === 'center'"}],
              "mark": {
                "type": "text",
                "align": "center",
                "baseline": "middle",
                "style": ["bubble-label", "label-halo"]
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            },
            {
              "transform": [{"filter": "datum.align === 'center'"}],
              "mark": {
                "type": "text",
                "align": "center",
                "baseline": "middle",
                "style": "bubble-label"
              },
              "encoding": {
                "longitude": {"field": "llon", "type": "quantitative"},
                "latitude": {"field": "llat", "type": "quantitative"},
                "text": {"field": "label"}
              }
            }
          ]
        }
      ]
    }
  ],
  "resolve": {"scale": {"color": "shared"}}
}
